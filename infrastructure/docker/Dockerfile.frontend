# =============================================================================
# AGENTIC TRADER - FRONTEND DEVELOPMENT DOCKERFILE
# Vite + React 19 + Hot Reload
# =============================================================================

FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install system dependencies for native modules
RUN apk add --no-cache \
    libc6-compat \
    curl

# Copy package files
COPY package*.json ./

# Install dependencies (use npm ci for deterministic installs)
RUN npm ci --include=dev

# Copy config files
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./
COPY components.json ./

# Create necessary directories (source will be mounted as volume)
RUN mkdir -p src public

# Set environment variables
ENV NODE_ENV=development
ENV VITE_API_URL=http://localhost:8005
ENV VITE_WS_URL=ws://localhost:8005
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

# Expose Vite dev server port and HMR port
EXPOSE 3000
EXPOSE 24678

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
