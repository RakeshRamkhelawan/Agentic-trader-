{
  "dashboard": {
    "title": "Trading Platform - Positions & P&L",
    "tags": ["trading", "positions", "pnl"],
    "timezone": "UTC",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Position Sizes by Symbol",
        "type": "bargauge",
        "targets": [
          {
            "expr": "sum by (symbol) (trading_position_size)",
            "legendFormat": "{{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Position Values (EUR)",
        "type": "bargauge",
        "targets": [
          {
            "expr": "sum by (symbol) (trading_position_value_eur)",
            "legendFormat": "{{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "Unrealized P&L by Symbol",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (symbol) (trading_unrealized_pnl_eur)",
            "legendFormat": "{{symbol}}"
          }
        ],
        "yAxes": [
          { "label": "EUR", "format": "currencyEUR" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Realized P&L Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(trading_realized_pnl_eur_total[1h])",
            "legendFormat": "{{symbol}}"
          }
        ],
        "yAxes": [
          { "label": "EUR/hour", "format": "currencyEUR" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 5,
        "title": "Exposure by Symbol",
        "type": "piechart",
        "targets": [
          {
            "expr": "trading_exposure_eur",
            "legendFormat": "{{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR"
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "Daily Volume",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(trading_daily_volume_eur[24h])",
            "legendFormat": "{{symbol}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR"
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
      },
      {
        "id": 7,
        "title": "Positions by Exchange",
        "type": "table",
        "targets": [
          {
            "expr": "trading_position_size",
            "format": "table",
            "instant": true
          }
        ],
        "columns": [
          { "text": "Symbol", "value": "symbol" },
          { "text": "Exchange", "value": "exchange" },
          { "text": "Size", "value": "Value" }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
      },
      {
        "id": 8,
        "title": "P&L Summary",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(trading_realized_pnl_eur_total)",
            "legendFormat": "Total Realized"
          },
          {
            "expr": "sum(trading_unrealized_pnl_eur)",
            "legendFormat": "Total Unrealized"
          },
          {
            "expr": "sum(trading_realized_pnl_eur_total) + sum(trading_unrealized_pnl_eur)",
            "legendFormat": "Total P&L"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR",
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0 },
                { "color": "green", "value": 1000 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 }
      }
    ]
  }
}
