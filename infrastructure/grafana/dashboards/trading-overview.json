{
  "dashboard": {
    "title": "Trading Platform - Overview",
    "tags": ["trading", "overview"],
    "timezone": "UTC",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Platform Status",
        "type": "stat",
        "targets": [
          {
            "expr": "trading_exchange_up",
            "legendFormat": "{{exchange}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "DOWN", "color": "red" },
                  "1": { "text": "UP", "color": "green" }
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Exchange Latency",
        "type": "stat",
        "targets": [
          {
            "expr": "trading_exchange_latency_seconds",
            "legendFormat": "{{exchange}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 2 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "Order Execution Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(trading_orders_total[5m])",
            "legendFormat": "{{exchange}} - {{side}} - {{status}}"
          }
        ],
        "yAxes": [
          { "label": "Orders/sec", "min": 0 }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
      },
      {
        "id": 4,
        "title": "Order Latency",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(trading_order_latency_seconds_bucket[5m])",
            "legendFormat": "{{exchange}}"
          }
        ],
        "dataFormat": "tsbuckets",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
      },
      {
        "id": 5,
        "title": "Trading Volume (EUR)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(trading_orders_value_eur_total[1h])",
            "legendFormat": "{{symbol}} - {{side}}"
          }
        ],
        "yAxes": [
          { "label": "EUR/hour", "format": "currencyEUR" }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
      },
      {
        "id": 6,
        "title": "Total P&L",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(trading_realized_pnl_eur_total)",
            "legendFormat": "Realized P&L"
          },
          {
            "expr": "sum(trading_unrealized_pnl_eur)",
            "legendFormat": "Unrealized P&L"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR"
          }
        },
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 20 }
      },
      {
        "id": 7,
        "title": "Total Exposure",
        "type": "gauge",
        "targets": [
          {
            "expr": "sum(trading_exposure_eur)",
            "legendFormat": "Exposure"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyEUR",
            "max": 50000,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 30000 },
                { "color": "red", "value": 45000 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 }
      },
      {
        "id": 8,
        "title": "Active Alerts",
        "type": "table",
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\"}",
            "format": "table"
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 }
      }
    ]
  }
}
