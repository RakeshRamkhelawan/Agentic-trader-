# LLM Configuration (Global Defaults)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_api_key_here

# DeepSeek AI Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://localhost:11434

# Per-Agent LLM Overrides (optional)
# Format: LLM_AGENT_{ROLE}_PROVIDER and LLM_AGENT_{ROLE}_MODEL
# Agents without override use the global LLM_PROVIDER / LLM_MODEL above.
# Example:
#   LLM_AGENT_RISK_MANAGER_PROVIDER=deepseek
#   LLM_AGENT_RISK_MANAGER_MODEL=deepseek-reasoner
#   LLM_AGENT_DATA_SCOUT_MODEL=deepseek-chat

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO


# Bybit Configuration
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=true

# Kraken Configuration
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET_KEY=your_kraken_secret_key
# TRADING_MODE: 'paper' (default) or 'live'
TRADING_MODE=paper

# --- SECURITY CONSTANTS ---

JWT_SECRET_KEY=change-this-to-secure-random-string
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DOCS_ENABLED=True
