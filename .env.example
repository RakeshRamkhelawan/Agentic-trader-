# Agentic Trader Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# SECURITY (Required)
# ============================================================================
SECRET_KEY=your-super-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars

# ============================================================================
# AUTH0 CONFIGURATION (Required for production)
# Get these from your Auth0 dashboard: https://manage.auth0.com
# ============================================================================
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://your-domain.auth0.com/api/v2/
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Set to 'true' for development without Auth0 (NOT for production!)
AUTH_DISABLED=false

# ============================================================================
# SSL/TLS CONFIGURATION (Optional - for HTTPS)
# ============================================================================
SSL_ENABLED=false
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# ============================================================================
# FRONTEND API URL
# ============================================================================
VITE_API_URL=http://localhost:8003
VITE_WS_URL=ws://localhost:8003/ws/public
VITE_DEMO_MODE=true

# ============================================================================
# DATABASE (Default values work with Docker Compose)
# ============================================================================
DATABASE_URL=postgresql+asyncpg://trader:trading_secure@postgres:5432/trading_db
REDIS_URL=redis://redis:6379/0
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CHROMA_HOST=chromadb
CHROMA_PORT=8000
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# LLM Provider: ollama, openai, deepseek
LLM_PROVIDER=ollama

# Ollama (Local LLM) - requires docker-compose --profile llm up -d
# Note: Use http://localhost:11435 for external access, http://ollama:11434 for internal Docker
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# OpenAI (Optional - if using OpenAI instead of Ollama)
OPENAI_API_KEY=your-openai-api-key

# DeepSeek (Optional - if using DeepSeek instead of Ollama)
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================================================
# PREDICTION MARKET INTELLIGENCE (Optional)
# ============================================================================
# Enable by running: docker-compose --profile prediction up -d
PREDICTION_INTELLIGENCE_URL=http://prediction-intelligence:8002

# Optional: API keys for prediction market data sources
KALSHI_API_KEY=your-kalshi-api-key
POLYMARKET_API_KEY=your-polymarket-api-key

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
