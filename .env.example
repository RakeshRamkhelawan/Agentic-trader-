# =============================================================================
# AGENTIC TRADER - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# SECURITY (REQUIRED FOR PRODUCTION)
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL (Primary Database)
DATABASE_URL=postgresql+asyncpg://trader:trading_secure@postgres:5432/trading_db
DB_USER=trader
DB_PASSWORD=trading_secure
DB_NAME=trading_db

# ClickHouse (TimeSeries & Analytics)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=trader
CLICKHOUSE_PASSWORD=trading_secure
CLICKHOUSE_DB=trading_db

# Redis (Cache & Event Bus)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ChromaDB (Vector Database)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# =============================================================================
# MESSAGE BROKER
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
KAFKA_TOPIC_PREFIX=trading

# =============================================================================
# EXTERNAL APIs - TRADING
# =============================================================================
# Bitvavo (Dutch Exchange)
BITVAVO_API_KEY=your_bitvavo_api_key
BITVAVO_API_SECRET=your_bitvavo_api_secret

# Revolut (Trading)
REVOLUT_API_KEY=your_revolut_api_key
REVOLUT_PRIVATE_KEY_PATH=./revolut_private.pem

# =============================================================================
# EXTERNAL APIs - AI/LLM
# =============================================================================
# DeepSeek (Primary LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (Alternative)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================
# LLM Provider Selection
LLM_PROVIDER=deepseek  # Options: deepseek, openai, gemini, ollama

# Trading Mode
TRADING_MODE=paper  # Options: paper, live, backtest

# Risk Management
MAX_POSITION_SIZE=0.1  # 10% of portfolio per position
MAX_DAILY_LOSS=0.05    # 5% max daily loss
STOP_LOSS_PERCENTAGE=0.02  # 2% stop loss

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AI_TRADING=true
ENABLE_FEDERATED_TRIAD=true
ENABLE_NAVAGRAHA=true
ENABLE_36_TATTVA=true
ENABLE_OODA_LOOP=true
ENABLE_PREDICTION_MARKETS=true

# =============================================================================
# MONITORING
# =============================================================================
METRICS_SERVER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
FRONTEND_PORT=5173

# =============================================================================
# DEVELOPMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
RELOAD=true

# =============================================================================
# DOCKER
# =============================================================================
COMPOSE_PROJECT_NAME=agentic-trader
DOCKER_NETWORK=agentic-trader-network

# =============================================================================
# PREDICTION MARKETS
# =============================================================================
KALSHI_API_KEY=your_kalshi_api_key
POLYGON_RPC=https://polygon-rpc.com

# =============================================================================
# SOCIAL TRADING
# =============================================================================
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
# KYC Provider (SumSub, Onfido, etc.)
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=your_sumsub_token
SUMSUB_SECRET_KEY=your_sumsub_secret

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# =============================================================================
# BACKUPS
# =============================================================================
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key
BACKUP_RETENTION_DAYS=30
