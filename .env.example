# Agentic Trader Platform - Environment Configuration
# 
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# 
# NEVER commit .env to git (it's in .gitignore)!

# ============================================================================
# Core Settings
# ============================================================================

# Redis connection URL
# For Docker: redis://redis:6379/0
# For local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# Security (REQUIRED for production!)
# ============================================================================

# Generate with: openssl rand -hex 32
# SECRET_KEY=your-super-secret-key-here-change-in-production

# JWT secret for authentication
# JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# API key for external services (if needed)
# API_KEY=your-api-key-here

# ============================================================================
# Performance
# ============================================================================

# Number of Uvicorn workers (should match CPU cores)
UVICORN_WORKERS=4

# Max parallel workers for backtests
MAX_WORKERS=4

# ============================================================================
# Cache Settings
# ============================================================================

# VedAstro cache TTL (seconds)
CACHE_TTL_VEDASTRO=3600

# Market data cache TTL (seconds)
CACHE_TTL_MARKET_DATA=300

# Consensus cache TTL (seconds)
CACHE_TTL_CONSENSUS=60

# Enable/disable Redis cache
ENABLE_CACHE=true

# ============================================================================
# Feature Flags
# ============================================================================

# Enable parallel processing
ENABLE_PARALLEL=true

# Enable NumPy vectorization
ENABLE_VECTORIZATION=true

# Enable incremental backtesting
ENABLE_INCREMENTAL=true

# ============================================================================
# Database (if using PostgreSQL)
# ============================================================================

# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trader_db

# ============================================================================
# External Services (Optional)
# ============================================================================

# Broker API keys (for live trading)
# BROKER_API_KEY=your-broker-api-key
# BROKER_API_SECRET=your-broker-api-secret

# VedAstro service (if external)
# VEDASTRO_API_URL=https://api.vedastro.example.com

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Enable Prometheus metrics
# ENABLE_METRICS=true
# METRICS_PORT=9090

# OpenTelemetry endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ============================================================================
# Development (don't use in production!)
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable auto-reload (development only)
UVICORN_RELOAD=false
