# Agentic Trader Platform - Environment Configuration
# Copy this file to .env and fill in your values
# Poort allocatie: zie PORT_ALLOCATION.md

# ============================================================================
# CORE APPLICATION PORTS
# ============================================================================
API_PORT=8000
API_HOST=0.0.0.0
METRICS_PORT=9090

# ============================================================================
# SECURITY (REQUIRED - No defaults, must be set!)
# ============================================================================

# ⚠️  CRITICAL: Generate a secure random key (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_MIN_32_CHARS

# Legacy (deprecated, will be removed)
SECRET_KEY=deprecated-use-jwt-secret-key-instead

# ============================================================================
# AUTH0 CONFIGURATION (Required for production)
# Get these from your Auth0 dashboard: https://manage.auth0.com
# ============================================================================
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://your-domain.auth0.com/api/v2/
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Set to 'true' for development without Auth0 (NOT for production!)
AUTH_DISABLED=false

# ============================================================================
# SSL/TLS CONFIGURATION (Optional - for HTTPS)
# ============================================================================
SSL_ENABLED=false
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_DEV_PORT=3000
FRONTEND_PROD_PORT=3080
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEMO_MODE=true

# ============================================================================
# DATABASE - PostgreSQL (Poort 5432)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trader
POSTGRES_PASSWORD=trading_secure
DATABASE_URL=postgresql+asyncpg://trader:trading_secure@localhost:5432/trading_db

# ============================================================================
# ANALYTICS - ClickHouse (Poorten 5000/5001)
# ============================================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=5000
CLICKHOUSE_NATIVE_PORT=5001
CLICKHOUSE_URL=http://localhost:5000

# ============================================================================
# CACHE - Redis (Poort 6379)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# VECTOR DATABASE - ChromaDB (Poort 8100)
# ============================================================================
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8100
CHROMA_DB_URL=http://localhost:8100
CHROMA_HOST=localhost  # Legacy naam
CHROMA_PORT=8100       # Legacy naam

# ============================================================================
# MESSAGE BROKER - Redpanda (Poorten 6000/6001)
# ============================================================================
KAFKA_BROKERS=localhost:6000
KAFKA_BOOTSTRAP_SERVERS=localhost:6000
REDPANDA_ADMIN_URL=http://localhost:6001

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=9000
GRAFANA_PASSWORD=change-me-in-production
JAEGER_PORT=9001

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# LLM Provider: ollama, openai, deepseek, gemini
LLM_PROVIDER=deepseek

# Ollama (Local LLM) - Poort 11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key

# DeepSeek (Optional)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Gemini (Optional)
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# PREDICTION MARKET INTELLIGENCE (Optional)
# ============================================================================
PREDICTION_INTELLIGENCE_URL=http://prediction-intelligence:8002
KALSHI_API_KEY=your-kalshi-api-key
POLYMARKET_API_KEY=your-polymarket-api-key

# ============================================================================
# DEVELOPER TOOLS (Optionele poorten)
# ============================================================================
PGADMIN_PORT=10000
PGADMIN_DEFAULT_EMAIL=admin@agentictrader.com
PGADMIN_DEFAULT_PASSWORD=admin
REDIS_INSIGHT_PORT=10001

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
