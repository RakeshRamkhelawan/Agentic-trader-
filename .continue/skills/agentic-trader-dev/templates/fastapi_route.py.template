# ============================================================================
# Event Publishing Helper
# ============================================================================

event_bus = EventBus()

async def publish_{{RESOURCE_LOWER}}_event(
    event_type: str,
    data: dict[str, Any]
) -> str | None:
    """
    Publish {{RESOURCE_NAME}} event to Redis Streams.

    Args:
        event_type: Type of event (created, updated, deleted)
        data: Event payload

    Returns:
        Message ID if published, None if failed
    """
    try:
        event = {
            "type": f"{{RESOURCE_LOWER}}_{event_type}",
            "data": data,
            "timestamp": datetime.now(UTC).isoformat(),
        }
        message_id = await event_bus.publish("{{EVENT_STREAM}}", event)
        logger.info(f"Published {event_type} event: {message_id}")
        return message_id
    except Exception as e:
        logger.error(f"Failed to publish event: {e}")
        return None


