# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.prod and fill in your actual values
# NEVER commit .env.prod to git!
# =============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=trader
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=trading_db

# ============================================================================
# CLICKHOUSE CONFIGURATION
# ============================================================================
CLICKHOUSE_USER=trader
CLICKHOUSE_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
CLICKHOUSE_DB=trading_db

# ============================================================================
# GRAFANA CONFIGURATION
# ============================================================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="Agentic Trader Platform"
ENV=production
DEBUG=False
LOG_LEVEL=WARNING

# ============================================================================
# SECURITY CONSTANTS
# ============================================================================
# Generate a strong secret key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_STRONG_SECRET_KEY_MIN_32_CHARS

# ============================================================================
# CORS / ORIGINS
# ============================================================================
# Only allow your production domain
ALLOWED_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
DOCS_ENABLED=False

# ============================================================================
# INFRASTRUCTURE (Docker Service Names - NOT localhost)
# ============================================================================
# In Docker Compose, use service names as hostnames
DATABASE_URL="postgresql+asyncpg://trader:${DB_PASSWORD}@postgres:5432/trading_db"
REDIS_URL="redis://redis:6379/0"
KAFKA_BOOTSTRAP_SERVERS="redpanda:9092"
CLICKHOUSE_HOST="clickhouse"
CLICKHOUSE_PORT=8123
CHROMA_HOST="chromadb"
CHROMA_PORT=8000
METRICS_SERVER_PORT=8001

# ============================================================================
# EXTERNAL API CREDENTIALS
# ============================================================================
# Uncomment and fill in only the services you use in production

# Revolut API (Production)
# REVOLUT_API_KEY=""
# REVOLUT_PRIVATE_KEY_PATH="/app/secrets/revolut_private.pem"
# REVOLUT_SANDBOX=False

# Bitvavo API (Production)
# BITVAVO_API_KEY=""
# BITVAVO_API_SECRET=""
# BITVAVO_SANDBOX=False

# Kalshi API (Optional)
# KALSHI_API_KEY=""

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek AI
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# AUTH0 CONFIGURATION (Production)
# ============================================================================
AUTH0_DOMAIN=your-domain.eu.auth0.com
AUTH0_API_AUDIENCE=https://api.yourdomain.com
AUTH0_ISSUER=https://your-domain.eu.auth0.com/
AUTH0_ALGORITHM=RS256
AUTH0_CLIENT_ID=CHANGE_ME
AUTH0_CLIENT_SECRET=CHANGE_ME

# ============================================================================
# RISK LIMITS
# ============================================================================
MAX_ORDER_SIZE_EUR=10000.0
MAX_DAILY_LOSS_EUR=500.0

# ============================================================================
# PREDICTION MARKET SERVICE
# ============================================================================
PREDICTION_SERVICE_URL=http://prediction-intelligence:8002
PREDICTION_SERVICE_ENABLED=true
PREDICTION_SERVICE_TIMEOUT=30
PREDICTION_SERVICE_PORT=8002
